# 复制为 .env 后至少改掉 MEMLATTICE_TOKEN，其余保持默认即可跑起来。

# ---- 服务 ----
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# 需要留档时取消注释，会同时保留终端输出
# LOG_FILE=logs/app.log
ALLOWED_ORIGINS=http://localhost:8787

# ---- 鉴权（必改）----
# 所有 REST 与 MCP 调用都要带这个 Bearer Token；默认值等于没有鉴权。
MEMLATTICE_TOKEN=change-me-before-exposing

# ---- 存储 ----
# 默认 SQLite：单文件，零外部依赖。
SQLITE_PATH=./data/memlattice.db
# 想用 PostgreSQL 就取消下面这行；配了 DATABASE_URL 会自动切到 pg。
# DATABASE_URL=postgres://memlattice:memlattice@localhost:5432/memlattice
# 显式指定引擎，优先于自动判断：pg | sqlite
# DB_DIALECT=sqlite
DB_MAX_CONNECTIONS=10

# ---- 默认用户（单用户部署，保留 user_id 以便后续扩展）----
DEFAULT_USER_EXTERNAL_ID=default
DEFAULT_USER_DISPLAY_NAME=Me

# ---- 召回预算 ----
DEFAULT_BUDGET_TOKENS=1200
MAX_BUDGET_TOKENS=4000
# 弱关联提示条数，只出提示行、不占预算
WEAK_HINT_LIMIT=3

# ---- 生命周期（都能在 /settings 页面改，这里只是初始值）----
TERM_HALF_LIFE_DAYS=14
CARD_HALF_LIFE_DAYS=30
# 经验索引里那一行的长度上限
SKILL_MAX_CHARS=60
# 经验正文长度上限（按 block_id 下钻时取回）
SKILL_DETAIL_MAX_CHARS=4000
SKILL_INDEX_LIMIT=5
SKILL_L1_MAX_TOKENS=400
L1_IDLE_DEMOTE_DAYS=90
COLD_HEAT_THRESHOLD=0.5
COLD_IDLE_DAYS=90
SKELETON_MAX_CHARS=80
RAW_ARCHIVE_AFTER_DAYS=365
RAW_PURGE_AFTER_DAYS=730
TRASH_RESTORE_DAYS=7
KEEP_HISTORY_CARD_RATIO=0.10
RECENT_INDEX_LIMIT=15
RECENT_INDEX_TTL_DAYS=7

# ---- 写入与成卡 ----
CONDENSE_TURN_THRESHOLD=12
CONDENSE_MAX_ATTEMPTS=5
# 不传 event_id 时复用同 scope 下最近未成卡事件的窗口（分钟），0 关闭
WRITE_AUTO_RESUME_MINUTES=30
# 巡检把超过该小时数仍未成卡的事件收口，0 关闭
OPEN_EVENT_SWEEP_HOURS=2

# ---- 常驻层审核 ----
# 留空 = persona/rules/skills 全部由调用方直写；
# 填 rules,persona 则这些块的非人工写入进待审队列，需人工批准。
BLOCK_APPROVAL_LABELS=

# ---- 后台巡检 ----
WORKER_ENABLED=true
WORKER_HOUR=3

# ---- 说明 ----
# 摘要、意图、关键词、实体由调用方经 MCP memory.write 的 card 参数传入；
# 服务端不调用任何模型，未传的字段才用本地规则兜底。
