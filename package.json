{
  "name": "memlattice",
  "version": "0.1.12",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "MemLattice — 分层联想记忆系统（L1/L1.5/L2/L3 + 联想图 + 固化 + 淡忘）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mcp:stdio": "node dist/mcp-stdio.js",
    "mcp:stdio:dev": "tsx src/mcp-stdio.ts",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:prod": "node dist/db/migrate.js up",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:sqlite": "tsx scripts/smoke-sqlite.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke:http": "tsx scripts/http-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build:all": "npm run build && npm run web:build",
    "pack:runtime": "tsx scripts/pack-runtime.mts",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^1.10.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
